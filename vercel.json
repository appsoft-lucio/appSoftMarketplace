{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix backend --omit=dev && npm ci --prefix frontend --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "regions": [
    "gru1"
  ],
  "fluid": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/certs/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
