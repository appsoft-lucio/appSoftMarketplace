{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  null,
    "installCommand":  "npm ci --include=dev",
    "buildCommand":  "npm run build",
    "outputDirectory":  "apps/web/dist",
    "rewrites":  [
                     {
                         "destination":  "/api",
                         "source":  "/api/:path*"
                     },
                     { "source": "/meus-pedidos", "destination": "/index.html" },
                     { "source": "/minhas-lojas/:storeId/produtos", "destination": "/index.html" },
                     { "source": "/minhas-lojas/:storeId/frete", "destination": "/index.html" },
                     { "source": "/minhas-lojas/:storeId/pedidos", "destination": "/index.html" },
                     {
                         "source":  "/login",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/cadastro",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/recuperar-senha",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/redefinir-senha",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/confirmar-email",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/auth/confirmar",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/minha-conta",
                         "destination":  "/index.html"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/lojas"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/lojas/nova"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/admin"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/catalogo"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/minhas-lojas"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/minhas-lojas/nova"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/loja/:slug"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/produto/:id"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/carrinho"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/finalizar-compra"
                     }
                 ],
    "functions":  {
                      "api/index.ts":  {
                                           "maxDuration":  30,
                                           "includeFiles":  "apps/api/certs/**"
                                       }
                  },
    "headers":  [
                    {
                        "source": "/((?!api(?:/|$)|assets(?:/|$)|sw[.]js$).*)",
                        "headers": [
                            { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
                        ]
                    },
                    {
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store, max-age=0"
                                        },
                                        {
                                            "key":  "Service-Worker-Allowed",
                                            "value":  "/"
                                        }
                                    ],
                        "source":  "/sw.js"
                    }
                ]
}
