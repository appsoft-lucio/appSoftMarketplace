{
    "name":  "appsoft-marketplace",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.13.0 \u003c23"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "npm run dev --workspace @appsoft/web",
                    "dev:api":  "npm run dev --workspace @appsoft/api",
                    "build":  "npm run typecheck \u0026\u0026 npm run build --workspace @appsoft/web",
                    "typecheck":  "tsc --noEmit",
                    "test":  "tsx --test packages/domain/test/*.test.ts apps/api/test/*.test.ts database/test/*.test.ts \u0026\u0026 npm run test --workspace @appsoft/web"
                },
    "devDependencies":  {
                            "@electric-sql/pglite":  "0.5.17",
                            "@types/node":  "^22.0.0",
                            "tsx":  "4.23.15",
                            "typescript":  "7.0.2"
                        }
}
