{
    "name":  "@appsoft/domain",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "default":  "./dist/index.js"
                          },
                    "./appearance": { "types": "./src/appearance.ts", "default": "./dist/appearance.js" }, "./stores":  {
                                     "types":  "./src/stores.ts",
                                     "default":  "./dist/stores.js"
                                 },
                    "./admin":  {
                                    "types":  "./src/admin.ts",
                                    "default":  "./dist/admin.js"
                                },
                    "./catalog":  {
                                      "types":  "./src/catalog.ts",
                                      "default":  "./dist/catalog.js"
                                  },
                    "./checkout": {
                                      "types": "./src/checkout.ts",
                                      "default": "./dist/checkout.js"
                                  },
                    "./products": {
                                      "types": "./src/products.ts",
                                      "default": "./dist/products.js"
                                  },
                    "./cart":  {
                                   "types":  "./src/cart.ts",
                                   "default":  "./dist/cart.js"
                               }
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json"
                }
}